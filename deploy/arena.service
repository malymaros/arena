[Unit]
# systemd služba pre arena hru — beží ako node server.js, auto-reštart po páde/reboote
Description=Arena wizard duel (Express + Socket.IO)
After=network.target

[Service]
Type=simple
# Používateľ, pod ktorým appka beží. Na GCP VM (Debian) je to účet "arena"
# (odvodený z comentu SSH kľúča); na starej Oracle Ubuntu VM to bol "ubuntu".
User=arena
WorkingDirectory=/home/arena/arena
# Node počúva na porte 3000, verejne ho vystaví Caddy (HTTPS reverse proxy)
Environment=PORT=3000
# Zber herných dát (docs/TELEMETRY.md): denné JSONL súbory mimo repa; stiahnutie v menu ☰ → ADMIN → DOWNLOAD DATA
Environment=TELEMETRY_DIR=/home/arena/arena-data
# Admin heslo: hráč prihlásený ním je admin (reset roomiek v menu ☰; aj /admin/reset-all?key=…). Bez neho nie je admin nikto.
# Tajné hodnoty nedávaj do repa - na VM ich daj do override: sudo systemctl edit arena
#   [Service]
#   Environment=ADMIN_KEY=…
#   Environment=PLAYER_KEYS=…
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# Základné bezpečnostné obmedzenia
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
